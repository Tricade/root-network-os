# Copy to .env if you need different ports or a LAN/proxy address.
ROOT_IMAGE_TAG=latest
ROOT_HTTP_PORT=18473
ROOT_BIND_ADDRESS=127.0.0.1
# Browser URL, without path. Empty means http://127.0.0.1:<ROOT_HTTP_PORT>.
ROOT_PUBLIC_ORIGIN=
# LAN example: bind 0.0.0.0 and use http://192.168.1.50:18473 as the origin.
# ROOT has one shared save and no accounts. Use a private network/VPN or an authenticated proxy.
